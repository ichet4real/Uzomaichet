{
  "name": "uzomaichet-motion",
  "version": "1.0.0",
  "private": true,
  "description": "HTML, CSS and GSAP motion graphics with browser preview and frame-by-frame H.264 MP4 export",
  "type": "module",
  "scripts": {
    "check": "node scripts/check-env.mjs",
    "preview": "node scripts/serve.mjs",
    "render": "node scripts/capture.mjs --out output/flow-gsap.mp4 --poster output/flow-gsap-poster.png",
    "capture": "node scripts/capture.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  }
}
